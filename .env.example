# Variables du site Passerelle (Next.js). Toutes sont publiques (préfixe NEXT_PUBLIC_) :
# aucune clé secrète ne va dans le site. Sans ces variables, le site utilise les valeurs du projet actuel.

# Webhooks n8n (workflows 1, 2 et 6)
NEXT_PUBLIC_N8N_URL=https://<instance>.app.n8n.cloud/webhook

# Supabase : adresse du projet et clé publique (« publishable »)
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Edge Functions des agents H de demande (Visale, Mobili-Jeune) et de recherche de logement
NEXT_PUBLIC_DEMANDE_URL=https://<projet>.supabase.co/functions/v1/demande-h
NEXT_PUBLIC_LOGEMENT_URL=https://<projet>.supabase.co/functions/v1/logement-h
