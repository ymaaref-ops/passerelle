              "keyValue": "true"
            }
          ]
        }
      },
      "id": "ac7a142a-808d-43d9-a107-b4cbd2d70376",
      "name": "Lister les démarches automatisées",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        800,
        128
      ],
      "executeOnce": true,
      "credentials": {
        "supabaseOAuth2Api": {
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const demarches = $input.all().map(i => i.json).filter(d => d.aide_code);\nconst enAttente = demarches.filter(d => d.statut === 'en_cours');\nconst NOMS = { apl: 'APL (CAF)', prime_activite: \"Prime d'activité (CAF)\", pret_garanti: 'Comparaison de prêts étudiants', bourse_crous: 'Bourse du Crous' };\nconst ESPACE = { bourse_crous: 'ton dossier social étudiant sur messervices.etudiant.gouv.fr' };\nconst lignes = demarches.map(d => {\n  const nom = NOMS[d.aide_code] || d.aide_code;\n  if (d.statut === 'pret_a_valider') return `- ${nom} : prêt à consulter${d.montant_estime ? ` (${d.montant_estime} €)` : ''}`;\n  if (d.statut === 'connexion_requise') return `- ${nom} : simulation faite${d.montant_estime !== null && d.montant_estime !== undefined ? ` (${d.montant_estime} €/mois estimés)` : ''}, à finir sur ${ESPACE[d.aide_code] || 'ton espace caf.fr'}`;\n  if (d.statut === 'en_cours') return `- ${nom} : en cours, l'agent travaille encore`;\n  return `- ${nom} : bloqué, on te guide pour le finir`;\n});\nreturn [{ json: { tout_pret: demarches.length > 0 && enAttente.length === 0, resume: lignes.join('\\n'),\n                  etudiant_id: $('Préparer le résultat').first().json.etudiant_id } }];"
      },
      "id": "979a360a-69da-49e2-b5ee-7cc870ccf1ea",
      "name": "Tout est prêt ?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
