    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "getAll",
        "projectRef": "hnziztstifpipxrgdnop",
        "tableId": "demarches",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "etudiant_id",
              "condition": "eq",
              "keyValue": "={{ $('Préparer le résultat').first().json.etudiant_id }}"
            },
            {
              "keyName": "niveau",
              "condition": "eq",
              "keyValue": "automatisee"
            },
            {
              "keyName": "cochee",
