{
  "name": "Passerelle – 3. Retour des agents",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "passerelle/resultat-agent",
        "options": {}
      },
      "id": "b982af9b-defd-4b67-a041-9ca2580c3509",
      "name": "Résultat d’un agent",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json.body || {};\nconst STATUTS_H = ['completed', 'failed', 'timed_out', 'interrupted'];\nconst connexion_requise = r.connexion_requise === true || r.statut === 'connexion_requise'\n  || /connexion|identifiant|mot de passe|login|franceconnect/i.test(r.etape_bloquante || '');\nreturn [{ json: {\n  demarche_id: r.demarche_id, etudiant_id: r.etudiant_id, site: r.site,\n  agent: r.agent || 'h/web-surfer-flash', session_id: r.session_id || null,\n  statut: STATUTS_H.includes(r.statut) ? r.statut : (connexion_requise ? 'interrupted' : 'erreur'),\n  debut: r.debut, fin: r.fin || new Date().toISOString(),\n  credits: r.credits ?? null, resultat: r.resultat ?? null,\n  montant_lu: r.montant_lu ?? null, etape_bloquante: r.etape_bloquante || null, erreur: r.erreur || null,\n  connexion_requise,\n  documents_generes: r.documents_generes ?? null,\n} }];"
      },
      "id": "a110978c-4518-4b18-805d-71c6c4208a19",
      "name": "Préparer le résultat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        128
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "projectRef": "hnziztstifpipxrgdnop",
        "tableId": "passages_agents",
        "dataToSend": "autoMapInputData",
        "inputsToIgnore": "connexion_requise,documents_generes"
      },
      "id": "f633073d-6ceb-4631-a5a1-7f059f26c4ea",
      "name": "Journal des passages d'agents",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        496,
        128
      ],
      "credentials": {
        "supabaseOAuth2Api": {
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $('Préparer le résultat').first().json;\nconst maj = {\n  demarche_id: r.demarche_id,\n  statut: r.connexion_requise ? 'connexion_requise' : (r.statut === 'completed' ? 'pret_a_valider' : 'bloquee'),\n  resultat_agent: { ...(r.resultat || {}), etape_bloquante: r.etape_bloquante, erreur: r.erreur, session_id: r.session_id },\n  updated_at: new Date().toISOString(),\n};\nif (r.montant_lu !== null) maj.montant_estime = r.montant_lu;\nif (r.documents_generes) maj.documents_generes = r.documents_generes;\nreturn [{ json: maj }];"
      },
      "id": "df50a2c2-4e10-4f03-86c8-f70b8566d1d6",
      "name": "Préparer la mise à jour de la démarche",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        128
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "operation": "update",
        "projectRef": "hnziztstifpipxrgdnop",
        "tableId": "demarches",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.demarche_id }}"
            }
